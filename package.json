{
  "name": "pip-the-long-swim-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pip: The Long Swim Home \u2014 a mobile-first 3D underwater quiz adventure built with Three.js.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5181",
