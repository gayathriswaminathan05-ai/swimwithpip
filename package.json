    "test:browser": "node tests/playthrough.mjs",
    "deploy": "npm test && vite build && npx --yes wrangler@4 deploy"
  },
  "dependencies": {
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.6"
  }
}
